# Copy to .env (same folder as manage.py) and fill in. .env is git-ignored.
# Real environment variables always take precedence over this file.

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# Required whenever DJANGO_DEBUG=False; in debug a throwaway development key is used.
DJANGO_SECRET_KEY=

# Never True on a deployed server.
DJANGO_DEBUG=True

# Comma-separated hostnames this site may be served as.
# Defaults to localhost,127.0.0.1 in debug; required in production.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated frontend origins allowed to call the API (scheme included).
CORS_ALLOWED_ORIGINS=http://localhost:5180,http://127.0.0.1:5180,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# Origins trusted for CSRF-protected form/session POSTs (admin behind HTTPS).
# e.g. https://school.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Production-only toggles (ignored while DJANGO_DEBUG=True).
# Set to False if something in front of Django already redirects HTTP to HTTPS.
DJANGO_SECURE_SSL_REDIRECT=True
# Seconds for the HSTS header; use 0 until HTTPS is confirmed working.
DJANGO_SECURE_HSTS_SECONDS=31536000

# Deployment only. When set, Postgres is used instead of the local SQLite file.
# Render supplies this from the managed database; leave blank for local work.
DATABASE_URL=
# Set to False if the database host cannot negotiate SSL (some internal hosts).
DJANGO_DB_SSL_REQUIRE=True

# Set to 1 for one deploy to load demo data and the eight role logins, then
# back to 0. Always set SEED_ADMIN_PASSWORD with it - otherwise every seeded
# account gets the password published in seed_dev.py.
RUN_SEED=0
SEED_ADMIN_PASSWORD=
